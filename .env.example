# Credenciais do Banco de Dados (PostgreSQL)
POSTGRES_USER=seu_usuario_do_banco
POSTGRES_PASSWORD=sua_senha_do_banco
POSTGRES_DB=cultivares_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Credenciais de Leitura da API (Utilizado pelo docker-compose)
API_READER_USER=seu_usuario_api_reader
API_READER_PASSWORD=sua_senha_api_reader

# Configurações de API
API_LIMIT_PER_MINUTE=30
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE=data/logs/app.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
# CORS: origins permitidas separadas por vírgula. Deixe vazio para liberar wildcard (sem credentials).
# Exemplo: ALLOWED_ORIGINS=http://localhost:3000,https://seu-metabase.com
ALLOWED_ORIGINS=

# Sistema de Alertas (JSON Local)
# Diretório onde os JSONs de status serão gravados (relativo ao /app do container)
LOG_STATUS_PATH=data/logs


# Anos consolidados e explícitos para extração de dados do IBGE/SIDRA (PAM)
SIDRA_ANOS=2021,2022,2023,2024

# Safra oficial usada na tábua de risco do ZARC
ZARC_SAFRA=2025-2026

# Trilha de correções e rejeições de datas do SIGEF
SIGEF_QUARANTINE_PATH=data/sigef/campos_producao_quarentena.csv
