# Credenciais do Banco de Dados (PostgreSQL)
POSTGRES_USER=seu_usuario_do_banco
POSTGRES_PASSWORD=sua_senha_do_banco
POSTGRES_DB=cultivares_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Credenciais de Leitura da API (Utilizado pelo docker-compose)
API_READER_USER=seu_usuario_api_reader
API_READER_PASSWORD=sua_senha_api_reader

# Configurações de API
API_LIMIT_PER_MINUTE=30

# Sistema de Alertas (opcional)
# Crie um bot em https://t.me/botfather e obtenha seu chat ID em https://t.me/userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# true = envia alerta mesmo quando tudo OK; false = apenas em caso de falha
ALERT_ON_SUCCESS=false
# Diretório onde os JSONs de status serão gravados (relativo ao /app do container)
LOG_STATUS_PATH=data/logs
